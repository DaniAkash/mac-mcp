{
  "name": "mac-mcp",
  "version": "0.0.0",
  "description": "Read-only MCP server for native macOS apps (Mail, Notes, Calendar, Reminders, Contacts, Messages, Spotlight).",
  "homepage": "https://github.com/DaniAkash/mac-mcp#readme",
  "bugs": {
    "url": "https://github.com/DaniAkash/mac-mcp/issues"
  },
  "license": "MIT",
  "author": "Dani Akash <DaniAkash@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniAkash/mac-mcp.git"
  },
  "bin": {
    "mac-mcp": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./bin": "./dist/bin.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "bun test",
    "lint": "vp lint",
    "fmt": "vp fmt --check",
    "fmt:fix": "vp fmt --write",
    "fallow": "fallow check",
    "check": "concurrently --group --names lint,fmt,fallow --prefix-colors auto \"bun run lint\" \"bun run fmt\" \"bun run fallow\"",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.2",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "concurrently": "^10.0.3",
    "fallow": "^2.89.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
