{
  "name": "mac-mcp",
  "version": "0.0.0",
  "description": "Read-only MCP server for native macOS apps (Mail, Notes, Calendar, Reminders, Contacts, Messages, Spotlight).",
  "homepage": "https://github.com/DaniAkash/mac-mcp#readme",
  "bugs": {
    "url": "https://github.com/DaniAkash/mac-mcp/issues"
  },
  "license": "MIT",
  "author": "Dani Akash <DaniAkash@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniAkash/mac-mcp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14"
}
